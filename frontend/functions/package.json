{
  "name": "itinerarios-functions",
  "description": "Cerro Verde CLocator proxy (Firebase) — GPS sin egress Supabase",
  "engines": { "node": "20" },
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=lib/index.js --format=cjs --external:firebase-functions --external:firebase-admin --loader:.json=json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions:cerroVerdeClocator"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "cheerio": "1.1.2",
    "fetch-cookie": "3.1.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.0",
    "jose": "6.1.0",
    "tough-cookie": "5.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "private": true
}
